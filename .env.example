# Required: PostgreSQL used by the running app. These are LOCAL sample credentials.
DATABASE_URL="postgresql://portfolio:portfolio_local_only@127.0.0.1:5432/portfolio"
# Required by Prisma CLI. With local PostgreSQL, use the same URL as above.
# Hosted services may supply a separate direct (non-pooled) connection URL.
DIRECT_URL="postgresql://portfolio:portfolio_local_only@127.0.0.1:5432/portfolio"
# Required for admin login. Generate separate random values; never deploy sample passwords.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
SITE_URL="http://localhost:3000"

# Optional AI assistant. Without a key, the widget shows an unavailable state.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional GitHub section. No account is fetched when the username is empty.
GITHUB_USERNAME=""
# Optional token. Only grant permissions required for your chosen account.
# Token-backed data may include private contribution totals; review before enabling.
GITHUB_TOKEN=""
# Optional Spotify integration. All values are server-side secrets except the redirect URL.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"
SPOTIFY_REFRESH_TOKEN=""
